<UserControl x:Class="PreciseClock.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <EventSetter Event="PreviewKeyDown" Handler="OnFieldKeyDown" />
            <EventSetter Event="LostKeyboardFocus" Handler="OnFieldLostFocus" />
        </Style>

        <!-- 세로 막대 위의 위치 표시 -->
        <Style x:Key="Marker" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Canvas.Left" Value="-4" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <!-- 선명함(가로) × 밝기(세로) 사각형 -->
            <StackPanel>
                <Border BorderBrush="#BDBDBD" BorderThickness="1">
                    <Grid x:Name="SvArea" Width="220" Height="220" Background="Transparent" Cursor="Cross"
                          MouseLeftButtonDown="OnAreaDown" MouseMove="OnAreaMove" MouseLeftButtonUp="OnAreaUp">
                        <Rectangle x:Name="HueFill" Fill="Red" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False">
                            <Grid x:Name="SvThumb" Width="14" Height="14">
                                <Ellipse Stroke="#99000000" StrokeThickness="1" />
                                <Ellipse Stroke="White" StrokeThickness="2" Margin="1" />
                            </Grid>
                        </Canvas>
                    </Grid>
                </Border>
                <TextBlock Style="{StaticResource Caption}" Text="가로 → 선명하게     세로 ↓ 어둡게" />
            </StackPanel>

            <!-- 색상(Hue) 막대 -->
            <StackPanel Margin="14,0,0,0">
                <Grid x:Name="HueArea" Width="18" Height="222" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="OnAreaDown" MouseMove="OnAreaMove" MouseLeftButtonUp="OnAreaUp"
                      MouseWheel="OnAreaWheel">
                    <Rectangle Stroke="#BDBDBD">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF0000" Offset="0" />
                                <GradientStop Color="#FFFF00" Offset="0.1667" />
                                <GradientStop Color="#00FF00" Offset="0.3333" />
                                <GradientStop Color="#00FFFF" Offset="0.5" />
                                <GradientStop Color="#0000FF" Offset="0.6667" />
                                <GradientStop Color="#FF00FF" Offset="0.8333" />
                                <GradientStop Color="#FF0000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="HueThumb" Style="{StaticResource Marker}">
                            <Border BorderBrush="White" BorderThickness="1.5" CornerRadius="1" />
                        </Border>
                    </Canvas>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Text="색상" />
            </StackPanel>

            <!-- 투명도 막대 -->
            <StackPanel Margin="10,0,0,0">
                <Grid x:Name="AlphaArea" Width="18" Height="222" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="OnAreaDown" MouseMove="OnAreaMove" MouseLeftButtonUp="OnAreaUp"
                      MouseWheel="OnAreaWheel">
                    <Rectangle Fill="{StaticResource Checker}" />
                    <Rectangle x:Name="AlphaFill" Stroke="#BDBDBD" />
                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="AlphaThumb" Style="{StaticResource Marker}">
                            <Border BorderBrush="White" BorderThickness="1.5" CornerRadius="1" />
                        </Border>
                    </Canvas>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Text="투명도" />
            </StackPanel>
        </StackPanel>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 새 색 / 처음 색 비교 (포토샵 방식) -->
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,3" Text="새 색" />
                <Grid Width="54" Height="58">
                    <Border BorderBrush="#BDBDBD" BorderThickness="1" Background="{StaticResource Checker}" />
                    <Grid Margin="1">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border x:Name="NewSwatch" />
                        <Border x:Name="OldSwatch" Grid.Row="1" Cursor="Hand"
                                ToolTip="누르면 이 창을 열었을 때의 색으로 되돌립니다"
                                MouseLeftButtonDown="OnOldSwatchClick" />
                    </Grid>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" Text="처음 색" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="18,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Label}" Text="#" />
                    <TextBox x:Name="HexBox" Style="{StaticResource Field}" Width="76" HorizontalContentAlignment="Left"
                             CharacterCasing="Upper" MaxLength="7" TextChanged="OnHexChanged"
                             ToolTip="색 코드 (예: FF9500). 다른 곳에서 복사해 붙여넣어도 됩니다" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="R" />
                    <TextBox x:Name="RBox" Style="{StaticResource Field}" MaxLength="3" TextChanged="OnRgbChanged" ToolTip="빨강 0~255" />
                    <TextBlock Style="{StaticResource Label}" Text="G" />
                    <TextBox x:Name="GBox" Style="{StaticResource Field}" MaxLength="3" TextChanged="OnRgbChanged" ToolTip="초록 0~255" />
                    <TextBlock Style="{StaticResource Label}" Text="B" />
                    <TextBox x:Name="BBox" Style="{StaticResource Field}" MaxLength="3" TextChanged="OnRgbChanged" ToolTip="파랑 0~255" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="불투명도" />
                    <TextBox x:Name="ABox" Style="{StaticResource Field}" Margin="0" MaxLength="3" TextChanged="OnAlphaChanged"
                             ToolTip="100 = 꽉 찬 색, 0 = 완전히 투명" />
                    <TextBlock Style="{StaticResource Label}" Margin="4,0,0,0" Text="%" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Margin="0,14,0,4" Foreground="#555555" Text="자주 쓰는 색" />
        <WrapPanel x:Name="Palette" Width="290" HorizontalAlignment="Left" />

        <TextBlock Margin="0,10,0,0" Foreground="#999999" FontSize="11" TextWrapping="Wrap" Width="290" HorizontalAlignment="Left"
                   Text="팁: 숫자 칸에서 ↑↓ 키로 1씩, Shift+↑↓ 로 10씩 바꿀 수 있어요. 막대 위에서 마우스 휠도 됩니다." />
    </StackPanel>
</UserControl>
